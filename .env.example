# Buonarroti is a local-only desktop app. The packaged build sets everything it
# needs at runtime — you only need this file for `pnpm dev` in a browser, and
# even then every value is optional (API keys are normally saved in-app via
# Settings → API Keys and stored in the local SQLite DB).

# Optional fallback kie.ai key (Settings → API Keys is the normal path).
KIE_API_KEY=

# Optional Azure OpenAI key, only if routing GPT Image 2 through Azure AI Foundry.
AZURE_API_KEY=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=

# Optional storage overrides. The desktop shell sets these to its app-data
# folder; in `pnpm dev` they default to `data/` and `public/generated/`.
BUONARROTI_DATA_DIR=
BUONARROTI_MEDIA_DIR=
