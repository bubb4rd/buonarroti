{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions, window dragging for the loading page, plus spawning the bundled Node server sidecar shim.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "buonarroti-node", "sidecar": true, "args": true }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "buonarroti-node", "sidecar": true, "args": true }]
    }
  ]
}
