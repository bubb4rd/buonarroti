{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buonarroti",
  "version": "1.2.1",
  "identifier": "app.buonarroti.desktop",
  "build": {
    "beforeDevCommand": "node scripts/desktop/build-server.mjs --dev",
    "beforeBuildCommand": "node scripts/desktop/build-server.mjs",
    "frontendDist": "./loading"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Buonarroti",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html",
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "backgroundColor": "#f5f2eb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/buonarroti-node"
    ],
    "resources": [
      "server/**/*"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Make images and film from your words.",
    "longDescription": "Buonarroti is a quiet desktop studio for making images and film from your words. Build workflows on an open canvas, talk ideas through with the assistant, and keep everything you make in one gallery. Your work stays on your machine.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {}
}
